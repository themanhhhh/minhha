NODE_ENV=development
API_PORT=4000
DATABASE_POOL_MODE=session
WEB_PORT=3000
# Supabase session pooler for the persistent NestJS API runtime (port 5432).
# Encode special characters in the database password before putting it in the URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?connection_limit=5"

# Supabase direct connection for Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# Supabase project values used by server-side file uploads.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="student-submissions"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_USE_MOCK="true"
