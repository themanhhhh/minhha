NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
# Supabase pooled connection for the API runtime (transaction pooler, port 6543).
# Encode special characters in the database password before putting it in the URL.
DATABASE_URL="postgresql://postgres.xxwdtscqwmhsamxnxqpe:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection for Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# Supabase project values used by server-side file uploads.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="student-submissions"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_USE_MOCK="true"
