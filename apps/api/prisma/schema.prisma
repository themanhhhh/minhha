generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ACADEMIC_STAFF
  DIRECTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  ACTIVE
  UPCOMING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  RESERVED
  COMPLETED
  CANCELLED
}

enum LessonStatus {
  IN_PROGRESS
  POSTPONED
  UPCOMING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum TestType {
  QUIZ
  MIDTERM
  FINAL
  JLPT
}

enum ReservationStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
}

enum NotificationType {
  ASSIGNMENT_CREATED
  MATERIAL_PUBLISHED
  LESSON_CREATED
  LESSON_UPDATED
  SCORE_PUBLISHED
  ATTENDANCE_ALERT
  CLASS_ENROLLED
  BROADCAST
  SYSTEM
}

model User {
  id            BigInt         @id(map: "NguoiDung_pkey") @default(autoincrement()) @map("ma_nguoi_dung")
  email         String         @unique(map: "NguoiDung_email_key") @db.VarChar(255)
  passwordHash  String         @map("mat_khau") @db.VarChar(255)
  fullName      String         @map("ho_ten") @db.VarChar(100)
  role          UserRole
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  student       Student?
  teacher       Teacher?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs     AuditLog[]
  uploadedMaterials ClassMaterial[]
  notifications Notification[] @relation("NotificationRecipient")
  createdNotifications Notification[] @relation("NotificationCreator")

  @@index([role, status], map: "NguoiDung_role_status_idx")
  @@map("NguoiDung")
  phone String? @unique @map("sdt") @db.VarChar(12)
  roleId Int @default(dbgenerated()) @map("ma_vai_tro_nguoi_dung")
  statusId Int @default(dbgenerated()) @map("ma_trang_thai")
  roleDefinition RoleDefinition @relation(fields: [roleId], references: [id])
  statusDefinition UserStatusDefinition @relation(fields: [statusId], references: [id])
}

model RefreshToken {
  id        BigInt    @id(map: "RefreshToken_pkey") @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenId   String    @unique(map: "RefreshToken_token_id_key") @map("token_id") @db.VarChar(36)
  tokenHash String    @unique(map: "RefreshToken_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "RefreshToken_user_id_fkey")

  @@index([userId, revokedAt], map: "RefreshToken_user_id_revoked_at_idx")
  @@map("RefreshToken")
}

model PasswordResetToken {
  id        BigInt    @id(map: "PasswordResetToken_pkey") @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenId   String    @unique(map: "PasswordResetToken_token_id_key") @map("token_id") @db.VarChar(36)
  tokenHash String    @unique(map: "PasswordResetToken_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordResetToken_user_id_fkey")

  @@index([userId, usedAt], map: "PasswordResetToken_user_id_used_at_idx")
  @@map("PasswordResetToken")
}

model Student {
  id             BigInt              @id(map: "HocVien_pkey") @default(autoincrement()) @map("ma_hoc_vien")
  userId         BigInt              @unique(map: "HocVien_user_id_key") @map("ma_nguoi_dung")
  studentCode    String              @unique(map: "HocVien_student_code_key") @map("student_code") @db.VarChar(30)
  gender         String?             @db.VarChar(20)
  dateOfBirth    DateTime            @map("ngay_sinh") @db.Date
  currentLevel   JlptLevel?          @map("current_level")
  targetLevel    JlptLevel?          @map("target_level")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "HocVien_user_id_fkey")
  enrollments    Enrollment[]
  transfers      ClassTransfer[]
  reservations   StudyReservation[]
  attendance     Attendance[]
  scores         Score[]
  submissions    AssignmentSubmission[]
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([currentLevel], map: "HocVien_current_level_idx")
  @@map("HocVien")
  goal String? @map("muc_tieu") @db.VarChar(255)
  emergencyContact String? @map("lien_he_khan_cap") @db.VarChar(255)
  currentLevelId Int? @map("ma_trinh_do_hien_tai")
  targetLevelId Int? @map("ma_trinh_do_muc_tieu")
  currentLevelDefinition JlptDefinition? @relation("StudentCurrentLevel", fields: [currentLevelId], references: [id])
  targetLevelDefinition JlptDefinition? @relation("StudentTargetLevel", fields: [targetLevelId], references: [id])
}

model Teacher {
  id             BigInt         @id(map: "GiaoVien_pkey") @default(autoincrement()) @map("ma_giao_vien")
  userId         BigInt         @unique(map: "GiaoVien_user_id_key") @map("ma_nguoi_dung")
  teacherCode    String         @unique(map: "GiaoVien_teacher_code_key") @map("teacher_code") @db.VarChar(30)
  phone          String?        @db.VarChar(30)
  jlptLevel      JlptLevel?     @map("jlpt_level")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "GiaoVien_user_id_fkey")
  classes        Class[]        @relation("TeacherClasses")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("GiaoVien")
  jlptLevelId Int? @map("ma_trinh_do_jlpt")
  levelDefinition JlptDefinition? @relation(fields: [jlptLevelId], references: [id])
  substituteLessons Lesson[]
}

model Course {
  id            BigInt         @id(map: "KhoaHoc_pkey") @default(autoincrement()) @map("ma_khoa_hoc")
  code          String         @unique(map: "KhoaHoc_code_key") @db.VarChar(30)
  name          String         @db.VarChar(100) @map("ten_khoa_hoc")
  level         JlptLevel
  totalLessons  Int            @map("so_buoi_hoc")
  tuition       Decimal        @db.Decimal(15, 2) @map("hoc_phi")
  status        CourseStatus   @default(ACTIVE)
  classes       Class[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([level, status], map: "KhoaHoc_level_status_idx")
  @@map("KhoaHoc")
  description String? @map("mo_ta") @db.VarChar(255)
  levelId Int @default(dbgenerated()) @map("ma_trinh_do_jlpt")
  levelDefinition JlptDefinition @relation(fields: [levelId], references: [id])
}

model Class {
  id                BigInt              @id(map: "LopHoc_pkey") @default(autoincrement()) @map("ma_lop_hoc")
  code              String              @unique(map: "LopHoc_code_key") @db.VarChar(30)
  name              String              @db.VarChar(100) @map("ten_lop_hoc")
  courseId          BigInt              @map("course_id")
  teacherId         BigInt              @map("ma_giao_vien")
  startDate         DateTime            @map("ngay_khai_giang") @db.Date
  endDate           DateTime?           @map("ngay_ket_thuc") @db.Date
  schedule          String              @db.VarChar(100) @map("lich_hoc")
  room              String?             @db.VarChar(100)
  capacity          Int                 @default(20) @map("si_so_toi_da")
  status            ClassStatus         @default(UPCOMING)
  course            Course              @relation(fields: [courseId], references: [id], map: "LopHoc_course_id_fkey")
  teacher           Teacher             @relation("TeacherClasses", fields: [teacherId], references: [id], map: "LopHoc_teacher_id_fkey")
  enrollments       Enrollment[]
  lessons           Lesson[]
  tests             Test[]
  outgoingTransfers ClassTransfer[]     @relation("FromClassTransfers")
  incomingTransfers ClassTransfer[]     @relation("ToClassTransfers")
  reservations      StudyReservation[]
  assignments       Assignment[]
  materials         ClassMaterial[]
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([courseId, status], map: "LopHoc_course_id_status_idx")
  @@index([teacherId, status], map: "LopHoc_teacher_id_status_idx")
  @@map("LopHoc")
  session String? @map("ca_hoc") @db.VarChar(50)
  studentCount Int @default(0) @map("si_so_hien_tai")
  meetingUrl String? @map("link_vao_hoc") @db.VarChar(255)
}

model Enrollment {
  id         BigInt           @id(map: "DangKyLop_pkey") @default(autoincrement()) @map("ma_dang_ky")
  studentId  BigInt           @map("ma_hoc_vien")
  classId    BigInt           @map("ma_lop_hoc")
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  leftAt     DateTime?        @map("left_at") @db.Timestamptz(3)
  student    Student          @relation(fields: [studentId], references: [id], map: "DangKyLop_student_id_fkey")
  class      Class            @relation(fields: [classId], references: [id], map: "DangKyLop_class_id_fkey")

  @@unique([studentId, classId], map: "DangKyLop_student_id_class_id_key")
  @@index([classId, status], map: "DangKyLop_class_id_status_idx")
  @@index([studentId, status], map: "DangKyLop_student_id_status_idx")
  @@map("DangKyHoc")
  joinedOn DateTime @default(dbgenerated()) @map("ngay_tham_gia") @db.Date
}

model ClassTransfer {
  id          BigInt         @id(map: "LichSuChuyenLop_pkey") @default(autoincrement()) @map("ma_chuyen_lop")
  studentId   BigInt         @map("ma_hoc_vien")
  fromClassId BigInt?        @map("ma_lop_hoc_cu")
  toClassId   BigInt         @map("ma_lop_hoc_moi")
  reason      String?        @db.VarChar(255) @map("ly_do_chuyen_lop")
  status      TransferStatus @default(REQUESTED)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  student     Student        @relation(fields: [studentId], references: [id], map: "LichSuChuyenLop_student_id_fkey")
  fromClass   Class?         @relation("FromClassTransfers", fields: [fromClassId], references: [id], map: "LichSuChuyenLop_from_class_id_fkey")
  toClass     Class          @relation("ToClassTransfers", fields: [toClassId], references: [id], map: "LichSuChuyenLop_to_class_id_fkey")

  @@index([studentId, status], map: "LichSuChuyenLop_student_id_status_idx")
  @@map("ChuyenLop")
  transferredOn DateTime? @map("ngay_chuyen_lop") @db.Date
}

model StudyReservation {
  id        BigInt            @id(map: "BaoLuu_pkey") @default(autoincrement()) @map("ma_bao_luu")
  studentId BigInt            @map("ma_hoc_vien")
  classId   BigInt            @map("ma_lop_hoc")
  reason    String?           @db.VarChar(255) @map("ly_do_bao_luu")
  status    ReservationStatus @default(PENDING)
  startDate DateTime?         @map("ngay_bao_luu") @db.Date
  endDate   DateTime?         @map("end_date") @db.Date
  student   Student           @relation(fields: [studentId], references: [id], map: "BaoLuu_student_id_fkey")
  class     Class             @relation(fields: [classId], references: [id], map: "BaoLuu_class_id_fkey")

  @@index([studentId, status], map: "BaoLuu_student_id_status_idx")
  @@map("BaoLuu")
  durationMonths Int? @map("thoi_han_bao_luu")
  isActive Boolean @default(false) @map("trang_thai_bao_luu")
}

model Lesson {
  id          BigInt         @id(map: "BuoiHoc_pkey") @default(autoincrement()) @map("ma_buoi_hoc")
  classId     BigInt         @map("ma_lop_hoc")
  title       String         @db.VarChar(100) @map("ten_buoi_hoc")
  lessonDate  DateTime       @map("lesson_date") @db.Date
  startTime   DateTime       @map("start_time") @db.Time(0)
  endTime     DateTime       @map("end_time") @db.Time(0)
  content     String?        @db.VarChar(255) @map("noi_dung_buoi_hoc")
  recordUrl   String?        @map("link_record") @db.VarChar(255)
  status      LessonStatus   @default(UPCOMING)
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade, map: "BuoiHoc_class_id_fkey")
  attendance  Attendance[]
  materials   ClassMaterial[]
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([classId, lessonDate], map: "BuoiHoc_class_id_lesson_date_idx")
  @@map("BuoiHoc")
  startsAt DateTime @default(dbgenerated()) @map("thoi_gian_bat_dau") @db.Timestamptz(0)
  endsAt DateTime @default(dbgenerated()) @map("thoi_gian_ket_thuc") @db.Timestamptz(0)
  substituteTeacherId BigInt? @map("ma_giao_vien_day_thay")
  substituteTeacher Teacher? @relation(fields: [substituteTeacherId], references: [id])
}

model Attendance {
  id        BigInt           @id(map: "DiemDanh_pkey") @default(autoincrement()) @map("ma_diem_danh")
  lessonId  BigInt           @map("ma_buoi_hoc")
  studentId BigInt           @map("ma_hoc_vien")
  status    AttendanceStatus
  note      String?          @db.VarChar(255) @map("ghi_chu")
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade, map: "DiemDanh_lesson_id_fkey")
  student   Student          @relation(fields: [studentId], references: [id], map: "DiemDanh_student_id_fkey")

  @@unique([lessonId, studentId], map: "DiemDanh_lesson_id_student_id_key")
  @@index([studentId, status], map: "DiemDanh_student_id_status_idx")
  @@map("DiemDanh")
  statusId Int @default(dbgenerated()) @map("ma_trang_thai_diem_danh")
  statusDefinition AttendanceDefinition @relation(fields: [statusId], references: [id])
}

model Test {
  id        BigInt    @id(map: "BaiKiemTra_pkey") @default(autoincrement()) @map("ma_bai_kiem_tra")
  classId   BigInt    @map("ma_lop_hoc")
  name      String    @db.VarChar(100) @map("ten_bai_kiem_tra")
  type      TestType
  maxScore  Decimal   @default(10) @map("max_score") @db.Decimal(5, 2)
  testDate  DateTime? @map("ngay_kiem_tra") @db.Date
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade, map: "BaiKiemTra_class_id_fkey")
  scores    Score[]

  @@index([classId, testDate], map: "BaiKiemTra_class_id_test_date_idx")
  @@map("BaiKiemTra")
  typeId Int @default(dbgenerated()) @map("ma_loai_bai_kiem_tra")
  typeDefinition TestTypeDefinition @relation(fields: [typeId], references: [id])
}

model Score {
  id        BigInt  @id(map: "DiemSo_pkey") @default(autoincrement()) @map("ma_diem_so")
  testId    BigInt  @map("ma_bai_kiem_tra")
  studentId BigInt  @map("ma_hoc_vien")
  value     Float @map("so_diem")
  note      String? @db.VarChar(500)
  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade, map: "DiemSo_test_id_fkey")
  student   Student @relation(fields: [studentId], references: [id], map: "DiemSo_student_id_fkey")

  @@unique([testId, studentId], map: "DiemSo_test_id_student_id_key")
  @@index([studentId], map: "DiemSo_student_id_idx")
  @@map("DiemSo")
}

model Assignment {
  id          BigInt       @id(map: "BaiTap_pkey") @default(autoincrement())
  classId     BigInt       @map("class_id")
  title       String       @db.VarChar(200)
  description String?      @db.Text
  dueAt       DateTime     @map("due_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade, map: "BaiTap_class_id_fkey")
  submissions AssignmentSubmission[]
  attachments AssignmentAttachment[]

  @@index([classId, dueAt], map: "BaiTap_class_id_due_at_idx")
  @@map("BaiTap")
}

model AssignmentAttachment {
  id           BigInt     @id(map: "TepBaiTap_pkey") @default(autoincrement())
  assignmentId BigInt     @map("assignment_id")
  storagePath  String     @map("storage_path") @db.VarChar(500)
  fileName     String     @map("file_name") @db.VarChar(255)
  mimeType     String     @map("mime_type") @db.VarChar(120)
  sizeBytes    Int        @map("size_bytes")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "TepBaiTap_assignment_id_fkey")

  @@index([assignmentId], map: "TepBaiTap_assignment_id_idx")
  @@map("TepBaiTap")
}

model ClassMaterial {
  id           BigInt    @id(map: "TaiLieuLop_pkey") @default(autoincrement())
  classId      BigInt    @map("class_id")
  lessonId     BigInt?   @map("lesson_id")
  createdBy    BigInt?   @map("created_by")
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  storagePath  String    @map("storage_path") @db.VarChar(500)
  fileName     String    @map("file_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(120)
  sizeBytes    Int       @map("size_bytes")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade, map: "TaiLieuLop_class_id_fkey")
  lesson       Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull, map: "TaiLieuLop_lesson_id_fkey")
  uploader     User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull, map: "TaiLieuLop_created_by_fkey")

  @@index([classId, createdAt], map: "TaiLieuLop_class_id_created_at_idx")
  @@index([lessonId], map: "TaiLieuLop_lesson_id_idx")
  @@map("TaiLieuLop")
}

model AssignmentSubmission {
  id           BigInt           @id(map: "NopBai_pkey") @default(autoincrement())
  assignmentId BigInt           @map("assignment_id")
  studentId    BigInt           @map("student_id")
  note         String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(3)
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "NopBai_assignment_id_fkey")
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "NopBai_student_id_fkey")
  files        AssignmentFile[]

  @@unique([assignmentId, studentId], map: "NopBai_assignment_id_student_id_key")
  @@index([studentId, submittedAt], map: "NopBai_student_id_submitted_at_idx")
  @@map("NopBai")
}

model AssignmentFile {
  id           BigInt               @id(map: "TepNopBai_pkey") @default(autoincrement())
  submissionId BigInt               @map("submission_id")
  storagePath  String               @map("storage_path") @db.VarChar(500)
  fileName     String               @map("file_name") @db.VarChar(255)
  mimeType     String               @map("mime_type") @db.VarChar(120)
  sizeBytes    Int                  @map("size_bytes")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, map: "TepNopBai_submission_id_fkey")

  @@index([submissionId], map: "TepNopBai_submission_id_idx")
  @@map("TepNopBai")
}

model AuditLog {
  id        BigInt   @id(map: "AuditLog_pkey") @default(autoincrement())
  actorId   BigInt?  @map("actor_id")
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, map: "AuditLog_actor_id_fkey")

  @@index([entity, entityId], map: "AuditLog_entity_entity_id_idx")
  @@index([actorId, createdAt], map: "AuditLog_actor_id_created_at_idx")
  @@map("AuditLog")
}

model Notification {
  id          BigInt           @id(map: "ThongBao_pkey") @default(autoincrement())
  recipientId BigInt           @map("recipient_id")
  createdById BigInt?          @map("created_by_id")
  type        NotificationType
  title       String           @db.VarChar(200)
  body        String           @db.Text
  actionUrl   String?          @map("action_url") @db.VarChar(500)
  entity      String?          @db.VarChar(100)
  entityId    String?          @map("entity_id") @db.VarChar(100)
  metadata    Json?
  dedupeKey   String?          @unique(map: "ThongBao_dedupe_key_key") @map("dedupe_key") @db.VarChar(255)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade, map: "ThongBao_recipient_id_fkey")
  createdBy   User?            @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull, map: "ThongBao_created_by_id_fkey")

  @@index([recipientId, readAt, createdAt], map: "ThongBao_recipient_id_read_at_created_at_idx")
  @@index([recipientId, createdAt], map: "ThongBao_recipient_id_created_at_idx")
  @@map("ThongBao")
}

