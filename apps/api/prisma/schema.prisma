generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ACADEMIC_STAFF
  DIRECTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  ACTIVE
  UPCOMING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  RESERVED
  COMPLETED
  CANCELLED
}

enum LessonStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum TestType {
  QUIZ
  MIDTERM
  FINAL
  JLPT
}

enum ReservationStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
}

model User {
  id            BigInt         @id @default(autoincrement())
  email         String         @unique @db.VarChar(320)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  fullName      String         @map("full_name") @db.VarChar(200)
  role          UserRole
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  student       Student?
  teacher       Teacher?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs     AuditLog[]

  @@index([role, status])
  @@map("NguoiDung")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenId   String    @unique @map("token_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("RefreshToken")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenId   String    @unique @map("token_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("PasswordResetToken")
}

model Student {
  id             BigInt              @id @default(autoincrement())
  userId         BigInt              @unique @map("user_id")
  studentCode    String              @unique @map("student_code") @db.VarChar(30)
  gender         String?             @db.VarChar(20)
  dateOfBirth    DateTime?           @map("date_of_birth") @db.Date
  currentLevel   JlptLevel?          @map("current_level")
  targetLevel    JlptLevel?          @map("target_level")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  transfers      ClassTransfer[]
  reservations   StudyReservation[]
  attendance     Attendance[]
  scores         Score[]
  submissions    AssignmentSubmission[]
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([currentLevel])
  @@map("HocVien")
}

model Teacher {
  id             BigInt         @id @default(autoincrement())
  userId         BigInt         @unique @map("user_id")
  teacherCode    String         @unique @map("teacher_code") @db.VarChar(30)
  phone          String?        @db.VarChar(30)
  jlptLevel      JlptLevel?     @map("jlpt_level")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes        Class[]        @relation("TeacherClasses")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("GiaoVien")
}

model Course {
  id            BigInt         @id @default(autoincrement())
  code          String         @unique @db.VarChar(30)
  name          String         @db.VarChar(200)
  level         JlptLevel
  totalLessons  Int            @map("total_lessons")
  tuition       Decimal        @db.Decimal(12, 2)
  status        CourseStatus   @default(ACTIVE)
  classes       Class[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([level, status])
  @@map("KhoaHoc")
}

model Class {
  id                BigInt              @id @default(autoincrement())
  code              String              @unique @db.VarChar(30)
  name              String              @db.VarChar(200)
  courseId          BigInt              @map("course_id")
  teacherId         BigInt              @map("teacher_id")
  startDate         DateTime            @map("start_date") @db.Date
  endDate           DateTime?           @map("end_date") @db.Date
  schedule          String              @db.VarChar(200)
  room              String?             @db.VarChar(100)
  capacity          Int                 @default(20)
  status            ClassStatus         @default(UPCOMING)
  course            Course              @relation(fields: [courseId], references: [id])
  teacher           Teacher             @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments       Enrollment[]
  lessons           Lesson[]
  tests             Test[]
  outgoingTransfers ClassTransfer[]     @relation("FromClassTransfers")
  incomingTransfers ClassTransfer[]     @relation("ToClassTransfers")
  reservations      StudyReservation[]
  assignments       Assignment[]
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([courseId, status])
  @@index([teacherId, status])
  @@map("LopHoc")
}

model Enrollment {
  id         BigInt           @id @default(autoincrement())
  studentId  BigInt           @map("student_id")
  classId    BigInt           @map("class_id")
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  leftAt     DateTime?        @map("left_at") @db.Timestamptz(3)
  student    Student          @relation(fields: [studentId], references: [id])
  class      Class            @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@index([classId, status])
  @@index([studentId, status])
  @@map("DangKyLop")
}

model ClassTransfer {
  id          BigInt         @id @default(autoincrement())
  studentId   BigInt         @map("student_id")
  fromClassId BigInt?        @map("from_class_id")
  toClassId   BigInt         @map("to_class_id")
  reason      String?        @db.VarChar(500)
  status      TransferStatus @default(REQUESTED)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  student     Student        @relation(fields: [studentId], references: [id])
  fromClass   Class?         @relation("FromClassTransfers", fields: [fromClassId], references: [id])
  toClass     Class          @relation("ToClassTransfers", fields: [toClassId], references: [id])

  @@index([studentId, status])
  @@map("LichSuChuyenLop")
}

model StudyReservation {
  id        BigInt            @id @default(autoincrement())
  studentId BigInt            @map("student_id")
  classId   BigInt            @map("class_id")
  reason    String?           @db.VarChar(500)
  status    ReservationStatus @default(PENDING)
  startDate DateTime?         @map("start_date") @db.Date
  endDate   DateTime?         @map("end_date") @db.Date
  student   Student           @relation(fields: [studentId], references: [id])
  class     Class             @relation(fields: [classId], references: [id])

  @@index([studentId, status])
  @@map("BaoLuu")
}

model Lesson {
  id          BigInt         @id @default(autoincrement())
  classId     BigInt         @map("class_id")
  title       String         @db.VarChar(200)
  lessonDate  DateTime       @map("lesson_date") @db.Date
  startTime   DateTime       @map("start_time") @db.Time(0)
  endTime     DateTime       @map("end_time") @db.Time(0)
  content     String?        @db.Text
  recordUrl   String?        @map("record_url") @db.VarChar(500)
  status      LessonStatus   @default(UPCOMING)
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance  Attendance[]
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([classId, lessonDate])
  @@map("BuoiHoc")
}

model Attendance {
  id        BigInt           @id @default(autoincrement())
  lessonId  BigInt           @map("lesson_id")
  studentId BigInt           @map("student_id")
  status    AttendanceStatus
  note      String?          @db.VarChar(500)
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId, status])
  @@map("DiemDanh")
}

model Test {
  id        BigInt    @id @default(autoincrement())
  classId   BigInt    @map("class_id")
  name      String    @db.VarChar(200)
  type      TestType
  maxScore  Decimal   @default(10) @map("max_score") @db.Decimal(5, 2)
  testDate  DateTime? @map("test_date") @db.Date
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  scores    Score[]

  @@index([classId, testDate])
  @@map("BaiKiemTra")
}

model Score {
  id        BigInt  @id @default(autoincrement())
  testId    BigInt  @map("test_id")
  studentId BigInt  @map("student_id")
  value     Decimal @db.Decimal(5, 2)
  note      String? @db.VarChar(500)
  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([testId, studentId])
  @@index([studentId])
  @@map("DiemSo")
}

model Assignment {
  id          BigInt       @id @default(autoincrement())
  classId     BigInt       @map("class_id")
  title       String       @db.VarChar(200)
  description String?      @db.Text
  dueAt       DateTime     @map("due_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([classId, dueAt])
  @@map("BaiTap")
}

model AssignmentSubmission {
  id           BigInt           @id @default(autoincrement())
  assignmentId BigInt           @map("assignment_id")
  studentId    BigInt           @map("student_id")
  note         String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(3)
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files        AssignmentFile[]

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
  @@map("NopBai")
}

model AssignmentFile {
  id           BigInt               @id @default(autoincrement())
  submissionId BigInt               @map("submission_id")
  storagePath  String               @map("storage_path") @db.VarChar(500)
  fileName     String               @map("file_name") @db.VarChar(255)
  mimeType     String               @map("mime_type") @db.VarChar(120)
  sizeBytes    Int                  @map("size_bytes")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("TepNopBai")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt?  @map("actor_id")
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("AuditLog")
}
